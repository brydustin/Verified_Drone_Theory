(* The proof chain for the theorems of Main/Degenerate_Configurations.thy, for Isabelle2026.

   Every session is strict (quick_and_dirty = false).  Build from this directory (ROOTS adds Munkres/):

     ~/Desktop/Isabelle/Isabelle2026/bin/isabelle build -b -d . Applied_Math_Oracle_Audit

   README.md has the map of the theories. *)

(* The Munkres formalization on top of the complex analysis library, in one heap. *)
session Applied_Math_Base in "Base" = "HOL-Complex_Analysis" +
  options [document = false, quick_and_dirty = false, timeout = 3600]
  sessions
    Munkres_Topology_Local
  theories
    Munkres_Topology_Local.Munkres_Topology

(* General analysis: meager sets, the regular value theorem, parametric transversality, functions whose
   restrictions to lines are entire, sets with countable line slices. *)
session Applied_Math_Analysis in "Analysis" = Applied_Math_Base +
  options [document = false, quick_and_dirty = false, timeout = 3600]
  theories
    Munkres_Baire_Bridge
    Meager_Sets
    Regular_Value_Theorem
    Parametric_Transversality_Euclidean
    Parametric_Transversality_Planar
    Line_Entire_Functions
    Negligible_Line_Slices

(* The model: array factor, pattern, dipole gain, steering wavevector, feasible and robust sets. *)
session Applied_Math_Pattern in "Pattern" = Applied_Math_Analysis +
  options [document = false, quick_and_dirty = false, timeout = 3600]
  theories
    Array_Factor
    Moment_Map
    Pattern_Derivatives
    Feasible_Set
    Dipole_Pattern
    Dipole_Gain_Derivatives
    Dipole_Gain_Analytic
    Robust_Sets
    Feasibility_Witness
    Pattern_Moments
    Gradient_Field_C1

(* Four of the five classes of degenerate configurations are meager. *)
session Applied_Math_Strata in "Strata" = Applied_Math_Pattern +
  options [document = false, quick_and_dirty = false, timeout = 3600]
  theories
    Null_Stratum
    Regular_Stratum
    Critical_Slices
    Main_Beam_Stratum
    Steering_Singular_Stratum

(* The fifth class, the residual. *)
session Applied_Math_Residual in "Residual" = Applied_Math_Strata +
  options [document = false, quick_and_dirty = false, timeout = 1800]
  theories
    Residual_Phase_Equation
    Residual_Equations
    Residual_Design
    Residual_Charts
    Residual_Chart_Cover
    Residual_Aligned
    Residual_Meager

(* The theorems: the degenerate configurations are closed and nowhere dense; the robust feasible set
   contains a ball.  Poles_And_Fixed_Margins: why the box avoids the poles and the margins depend on
   the configuration. *)
session Applied_Math_Main in "Main" = Applied_Math_Residual +
  options [document = false, quick_and_dirty = false, timeout = 1800]
  theories
    Degenerate_Configurations
    Poles_And_Fixed_Margins

(* Fails if one of the theorems depends on an oracle.  The control session checks that the test detects a sorry. *)
session Applied_Math_Oracle_Audit in "Audit" = Applied_Math_Main +
  options [document = false, quick_and_dirty = false, timeout = 600]
  sessions
    Applied_Math_Oracle_Audit_Control
  theories
    Oracle_Audit

session Applied_Math_Oracle_Audit_Control in "Audit/Control" = HOL +
  options [document = false, quick_and_dirty = true, timeout = 600]
  theories
    Oracle_Audit_Control
